# ============================================================
# UCMS Backend — Local Configuration Template
# ============================================================
# 1. Copy this file: cp application.yaml.example application.yaml
# 2. Fill in all [PLACEHOLDER] values below
# 3. Never commit application.yaml — it is gitignored
# ============================================================

spring:
  application:
    name: ucms-backend
  datasource:
    # Supabase Dashboard → Settings → Database → Connection string → JDBC tab
    # Replace [YOUR-PASSWORD] in the copied string with your DB password
    url: jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
    username: postgres
    # Supabase Dashboard → Settings → Database → Database password
    password: [YOUR-DB-PASSWORD]
  jpa:
    hibernate:
      ddl-auto: none
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: true
    locations: classpath:db/migration

supabase:
  # Supabase Dashboard → Settings → API → Project URL
  url: https://[YOUR-PROJECT-REF].supabase.co
  # Supabase Dashboard → Settings → API → anon (public) key — safe to share within team
  anon-key: [YOUR-ANON-KEY]
  # Supabase Dashboard → Settings → API → service_role (secret) key — BACKEND ONLY, never share publicly
  service-role-key: [YOUR-SERVICE-ROLE-KEY]
  # Constructed from your Project URL: https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
  jwks-uri: https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json
  # JWT issuer — same as your Supabase project URL + /auth/v1
  jwt-issuer: https://[YOUR-PROJECT-REF].supabase.co/auth/v1
  storage:
    # Private bucket name created in Supabase Dashboard → Storage → New bucket (toggle Public OFF)
    bucket: ticket-attachments
    # Signed URL expiry in seconds (short-lived)
    signed-url-expiry: 3600

gemini:
  # Google AI Studio API key for urgency scoring (backend only)
  api-key: ${GEMINI_API_KEY:}
  # Model for urgency scoring; keep configurable for rollout changes
  model: ${GEMINI_MODEL:gemini-2.5-flash}
  # Timeout in milliseconds before fallback rule engine is used
  timeout-ms: ${GEMINI_TIMEOUT_MS:4000}

urgency-rescore:
  # Enable periodic background urgency refresh for open tickets
  enabled: true
  # How often the scheduler runs (30 minutes)
  fixed-delay-ms: 1800000
  # Delay first run after app startup (2 minutes)
  initial-delay-ms: 120000
  # Max tickets processed per run
  batch-size: 50
  # Minimum age of existing urgency score before recalculating
  min-refresh-minutes: 30
